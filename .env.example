# =============================================================================
# Ayurvedic Clinical Bridge - Environment Configuration
# =============================================================================
# Copy this file to .env and update the values for your environment

# =============================================================================
# API Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# =============================================================================
# Security & Authentication
# =============================================================================
# Generate a secure secret key for JWT tokens
# You can generate one using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-replace-with-secure-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# =============================================================================
# Database Configuration (Optional - for future use)
# =============================================================================
# Currently not required but may be used for user data persistence
DATABASE_URL=sqlite:///./ayurvedic_bridge.db

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
ENABLE_AUDIT_LOGGING=true
ANONYMIZE_LOGS=true

# =============================================================================
# Development Settings
# =============================================================================
DEBUG=false
TESTING=false
ENVIRONMENT=development

# =============================================================================
# Data & Model Configuration
# =============================================================================
# Paths for data and model storage
MODEL_CACHE_DIR=./models
DATA_CACHE_DIR=./data/cache
COMPILED_KNOWLEDGE_DIR=./data/compiled_knowledge

# =============================================================================
# LLM Configuration for Clinical Reasoning & Enhanced Responses
# =============================================================================
# Choose LLM Provider: openai, anthropic, ollama, groq
LLM_PROVIDER=ollama

# Model Names:
# - OpenAI: gpt-4, gpt-3.5-turbo
# - Anthropic: claude-3-opus, claude-3-sonnet, claude-3-haiku
# - Ollama: mistral, llama2, neural-chat, etc. (requires Ollama running locally)
# - Groq: mixtral-8x7b-32768, llama2-70b-4096, etc.
LLM_MODEL=mistral

# API Keys (only needed for OpenAI, Anthropic, Groq)
# Get from: https://openai.com/api, https://console.anthropic.com, https://console.groq.com
LLM_API_KEY=

# API Base URL
# - OpenAI: https://api.openai.com/v1 (default, not needed)
# - Anthropic: https://api.anthropic.com (default, not needed)
# - Ollama: http://localhost:11434 (default local Ollama server)
# - Groq: https://api.groq.com/openai/v1 (default, not needed)
LLM_API_BASE=http://localhost:11434

# LLM Generation Settings
LLM_TEMPERATURE=0.7          # 0.0 (deterministic) to 1.0 (creative)
LLM_MAX_TOKENS=2000          # Maximum response length
LLM_REQUEST_TIMEOUT=30       # Timeout in seconds

# =============================================================================
# External API Configuration (Optional)
# =============================================================================
# Hugging Face API token for advanced NLP features (optional)
HUGGINGFACE_API_TOKEN=your_huggingface_token_here

# =============================================================================
# Performance Settings
# =============================================================================
MAX_WORKERS=4
BATCH_SIZE=32
MAX_SEQUENCE_LENGTH=512

# =============================================================================
# Safety and Compliance
# =============================================================================
DATA_RETENTION_DAYS=90
ENABLE_INTERACTION_WARNINGS=true
REQUIRE_PRACTITIONER_VERIFICATION=true

# =============================================================================
# CORS Configuration
# =============================================================================
# Frontend URLs that are allowed to access the API
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# =============================================================================
# Frontend Configuration (for reference)
# =============================================================================
# These should be set in frontend/.env file:
# VITE_BACKEND_URL=http://localhost:8000