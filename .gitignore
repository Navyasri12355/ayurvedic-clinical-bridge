# Python / Virtual Env
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.Python
*.egg-info/
.pytest_cache/
.coverage
htmlcov/

# Environment Variables
.env
.env.local
.env.*.local

# IDEs / Editors
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Node.js / Frontend (Vite)
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
frontend/.eslintcache
frontend/coverage/

# Data Files
# Ignore cache and large temp data
data/cache/
data/compiled_knowledge/
# Keep essential core datasets
!data/herb.json
!data/ayurgenix_dataset.csv
!data/ayurvedic_herbs_comprehensive.csv

# ML Models
# Ignore large model weights to save space/bandwidth
*.bin
*.pt
*.pth
*.h5
*.safetensors
*.onnx
*.pkl
*.joblib

# But keep model configuration and metadata
!models/**/config.json
!models/**/tokenizer.json
!models/**/tokenizer_config.json
!models/**/vocab.txt
!models/**/special_tokens_map.json
!models/**/added_tokens.json
!models/**/*_mappings.json
!models/**/model_status.json
!models/**/preprocessing_rules.json
!models/**/*_results.json

# Temporary / Backup files
tmp/
temp/
*.bak
*.old